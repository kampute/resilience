<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <Title>Kampute.Resilience</Title>
    <Description>A lightweight, dependency-free .NET library for retrying operations that fail transiently. Compose constant, linear, Fibonacci or exponential backoff with retry limits, elapsed-time limits, delay caps and jitter; build immutable, fluent retry policies that choose which exceptions and returned results to retry and hook into each retry; and run synchronous or asynchronous operations with little overhead. Retry sessions support retry loops that you write yourself.</Description>
    <Authors>Kambiz Khojasteh</Authors>
    <Version>1.1.0</Version>
    <Company>Kampute</Company>
    <Copyright>Copyright (c) 2026 Kampute</Copyright>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <PackageId>Kampute.Resilience</PackageId>
    <PackageTags>retry backoff resilience transient-fault exponential-backoff jitter</PackageTags>
    <PackageIcon>ICON.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReleaseNotes>For detailed release notes, please visit https://github.com/kampute/resilience/releases</PackageReleaseNotes>
    <PackageProjectUrl>https://kampute.github.io/resilience/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/kampute/resilience.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <NoWarn>IDE0290</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('../SigningKey.snk')">
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>../SigningKey.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../ICON.png" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
